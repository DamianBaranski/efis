#version 330 core

layout (location = 0) in vec3 position;
layout (location = 1) in vec2 texCoord;
layout (location = 2) in vec2 geoCoord;

out vec2 TexCoord;
out vec2 GeoCoord;

uniform mat4 mvpMatrix;

void main()
{
    gl_Position = mvpMatrix * vec4(position, 1.0);
    TexCoord = texCoord;
    GeoCoord = geoCoord;
}
