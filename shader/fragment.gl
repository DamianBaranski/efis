#version 300 es
precision mediump float;
precision highp int;
precision highp sampler2DArray;

in vec2 TexCoord;
in highp vec2 GeoCoord;
out vec4 fragColour;

uniform sampler2D texSampler;
uniform sampler2DArray satFine;
uniform sampler2DArray satMid;
uniform sampler2DArray satWide;
uniform int useOpenAip;
uniform highp ivec2 satFineOrigin;
uniform highp ivec2 satMidOrigin;
uniform highp ivec2 satWideOrigin;
uniform highp uint satFineBits[8];
uniform highp uint satMidBits[8];
uniform highp uvec2 satWideMask;
uniform int satFineZoom;
uniform int satMidZoom;
uniform int satWideZoom;
uniform int satFineGrid;
uniform int satMidGrid;

int modN(int v, int n)
{
    int m = v - (v / n) * n;
    return m < 0 ? m + n : m;
}

bool resident(highp uint bits[8], int bit)
{
    int word = bit >> 5;
    if (word < 0 || word >= 8)
    {
        return false;
    }
    return (bits[word] & (1u << uint(bit & 31))) != 0u;
}

vec4 sampleGrid(sampler2DArray tex, int zoom, highp ivec2 origin, int grid, highp uint bits[8])
{
    if (grid < 2)
    {
        return vec4(0.0);
    }
    highp float n = exp2(float(zoom));
    highp vec2 tilePos = GeoCoord * n;
    ivec2 tile = ivec2(floor(tilePos));
    ivec2 rel = tile - origin;
    if (rel.x < 0 || rel.y < 0 || rel.x >= grid || rel.y >= grid)
    {
        return vec4(0.0);
    }
    if (!resident(bits, rel.x + rel.y * grid))
    {
        return vec4(0.0);
    }
    int layer = modN(tile.x, grid) + modN(tile.y, grid) * grid;
    vec2 uv = clamp(vec2(tilePos.x - float(tile.x), tilePos.y - float(tile.y)), vec2(0.5 / 256.0), vec2(1.0 - 0.5 / 256.0));
    return texture(tex, vec3(uv, float(layer)));
}

void main()
{
    vec4 ground = texture(texSampler, TexCoord);
    if (useOpenAip == 0)
    {
        fragColour = ground;
        return;
    }

    highp vec2 deriv = max(abs(dFdx(GeoCoord)), abs(dFdy(GeoCoord)));
    float pixel = max(max(deriv.x, deriv.y), 1e-12);

    vec4 sat = sampleGrid(satMid, satMidZoom, satMidOrigin, satMidGrid, satMidBits);
    vec4 fine = sampleGrid(satFine, satFineZoom, satFineOrigin, satFineGrid, satFineBits);
    if (fine.a > 0.5 && pixel * exp2(float(satFineZoom)) * 256.0 <= 8.0)
    {
        sat = fine;
    }
    if (sat.a > 0.5)
    {
        fragColour = vec4(sat.rgb, 1.0);
    }
    else
    {
        fragColour = ground;
    }
}
